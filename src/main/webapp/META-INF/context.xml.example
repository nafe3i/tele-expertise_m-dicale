<?xml version="1.0" encoding="UTF-8"?>
<Context>
    <Resource
            name="jdbc/GestionClinique"
            auth="Container"
            type="javax.sql.DataSource"
            driverClassName="com.mysql.cj.jdbc.Driver"
            url="jdbc:mysql://localhost:3306/gestion_clinique"
            username="root"
            password="CHANGE_ME"
            maxTotal="20"
            maxIdle="10"
            maxWaitMillis="10000" />
</Context>
